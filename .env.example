# Copy to .env and fill in. .env is git-ignored.

# --- Models (all through the Vercel AI Gateway) -------------------------------------------
# One key for every model below: https://vercel.com/ai-gateway
# The Vercel account needs a card on file to unlock the free monthly credit.
AI_GATEWAY_API_KEY=

# Reads resume PDFs and extracts job requirements.
AI_MODEL=google/gemini-2.5-flash
# Rewrites resume lines for a job.
REWRITE_MODEL=openai/gpt-5-mini
# Scores, decisions and checks (Jev by TypeSafe).
JEV_MODEL=typesafe-ai/jev

# --- Workday -----------------------------------------------------------------------------
# The account used to sign in and apply. Email + password only: Google/LinkedIn sign-in
# can't be automated.
WORKDAY_EMAIL=
WORKDAY_PASSWORD=

# --- Web app -----------------------------------------------------------------------------
# Required anywhere but your own machine: the app can submit applications with your account.
APP_PASSWORD=
# PORT=3000

# --- Temporal --------------------------------------------------------------------------
# Empty = the local development server (`npm run temporal`). For Temporal Cloud:
# TEMPORAL_ADDRESS=
# TEMPORAL_NAMESPACE=<namespace>.<account>
# TEMPORAL_API_KEY=               # API key authentication (recommended)
# or mTLS instead of an API key, as files or as PEM text:
# TEMPORAL_TLS_CLIENT_CERT_PATH=  TEMPORAL_TLS_CLIENT_KEY_PATH=
# TEMPORAL_TLS_CLIENT_CERT_DATA=  TEMPORAL_TLS_CLIENT_KEY_DATA=

# --- Infrastructure (defaults shown) -----------------------------------------------------
# DATABASE_URL=postgres://autoapply:autoapply@localhost:5433/autoapply   # matches `npm run db`
# DATABASE_CA_CERT=               # PEM of the server's CA (e.g. Aiven); verifies the TLS connection
# DATABASE_SCHEMA=                # own schema for the tables, when the database is shared
# BLOB_READ_WRITE_TOKEN=          # Vercel Blob (private store) for files; empty = DATA_DIR on disk
# DATA_DIR=./data                 # files, when no Blob token is set
# BROWSER_CDP_URL=                # connect to a remote browser instead of launching Chromium
# HEADED=1                        # show the browser window of the apply worker
