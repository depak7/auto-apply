{
  "name": "autoapply",
  "version": "0.1.0",
  "private": true,
  "description": "Tailor your resume to a Workday job, review every change, and let a browser agent fill in the application.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "db": "docker compose up -d postgres",
    "api": "tsx src/bin/api.ts",
    "worker": "tsx src/bin/worker.ts",
    "apply-worker": "tsx src/bin/apply-worker.ts",
    "workers": "tsx src/bin/workers.ts",
    "temporal": "temporal server start-dev --db-filename data/temporal.db",
    "web:dev": "vite web",
    "web:build": "vite build web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "tool:record-form": "tsx tools/record-workday-form.ts",
    "tool:fetch-job": "tsx tools/fetch-job.ts",
    "tool:parse-resume": "tsx tools/parse-resume.ts",
    "tool:score": "tsx tools/score.ts",
    "tool:tailor": "tsx tools/tailor.ts",
    "tool:fill": "tsx tools/fill-application.ts",
    "tool:inspect-page": "tsx tools/inspect-page.ts",
    "tool:check-models": "tsx tools/check-models.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/common": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.113",
    "diff": "^9.0.0",
    "hono": "^4.13.9",
    "htmlparser2": "^12.0.0",
    "jose": "^6.2.12",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.11.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@temporalio/testing": "^1.24.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
